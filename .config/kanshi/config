output "BNQ BenQ EW270Q T5T00894019" {
        mode 2560x1440@200
        position 0,0
        scale 1.2
    alias $BENQ
}

output "Apple Computer Inc Color LCD Unknown" {
        mode 2880x1800@60Hz
        position 0,0
        scale 1.7
    alias $MacBook
}

profile home {
    output $BENQ 
    output $MacBook disable
}

profile outside {
    output $MacBook
}
