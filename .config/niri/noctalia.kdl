layout {

    focus-ring {
        active-color   "#ffb2be"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb2be"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb2be"
        inactive-color "#7d293e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb2be80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb2be"
        urgent-color "#ffb4ab"
    }
}
