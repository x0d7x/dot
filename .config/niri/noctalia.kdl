layout {

    focus-ring {
        active-color   "#ffb867"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb867"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb867"
        inactive-color "#673d00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb86780"
    }
}

recent-windows {
    highlight {
        active-color "#ffb867"
        urgent-color "#ffb4ab"
    }
}
