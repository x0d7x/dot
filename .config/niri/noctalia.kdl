layout {

    focus-ring {
        active-color   "#ffb3b3"
        inactive-color "#1b1107"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb3b3"
        inactive-color "#1b1107"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb3b3"
        inactive-color "#7e2a2f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb3b380"
    }
}

recent-windows {
    highlight {
        active-color "#ffb3b3"
        urgent-color "#ffb4ab"
    }
}
