layout {

    focus-ring {
        active-color   "#aecbd8"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aecbd8"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#aecbd8"
        inactive-color "#34505b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aecbd880"
    }
}

recent-windows {
    highlight {
        active-color "#aecbd8"
        urgent-color "#ffb4ab"
    }
}
