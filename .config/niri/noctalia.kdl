layout {

    focus-ring {
        active-color   "#6edbaa"
        inactive-color "#111412"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#6edbaa"
        inactive-color "#111412"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#6edbaa"
        inactive-color "#005237"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#6edbaa80"
    }
}

recent-windows {
    highlight {
        active-color "#6edbaa"
        urgent-color "#ffb4ab"
    }
}
