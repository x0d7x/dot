[backdrop]
enabled = true

[bar.default]
background_opacity = 0.59999998658895493
center = [ "group:g4", "privacy", "media", "recorder" ]
color = "primary"
end = [ "tray", "x0d7x/clipmask:clipmask", "group:g1", "volume", "battery", "group:g3", "control-center" ]
font_family = "JetBrains Mono"
margin_edge = 5
margin_ends = 160
padding = 11
radius = 15
start = [ "launcher", "group:g2", "active_window" ]

    [[bar.default.capsule_group]]
    fill = "on_tertiary"
    id = "g2"
    members = [ "sysmon", "temp", "ram" ]
    opacity = 0.0
    padding = 6.0

    [[bar.default.capsule_group]]
    fill = "surface_variant"
    id = "g1"
    members = [ "network", "bluetooth" ]
    opacity = 0.0
    padding = 6.0

    [[bar.default.capsule_group]]
    fill = "surface_variant"
    id = "g3"
    members = [ "date", "clock" ]
    opacity = 0.0
    padding = 7.0

    [[bar.default.capsule_group]]
    fill = "surface_variant"
    id = "g4"
    members = [ "status", "workspaces" ]
    opacity = 0.55000001192092896
    padding = 6.0

[battery]
warning_threshold = 18

[desktop_widgets]
enabled = false

[dock]
active_monitor_only = true
auto_hide = true
enabled = true
launcher_position = "start"
reserve_space = false
show_dots = true

[idle]
pre_action_fade_seconds = 13

[keybinds]
down = [ "Ctrl+j" ]
left = [ "Ctrl+h" ]
right = [ "Ctrl+l" ]
up = [ "Ctrl+k" ]

[lockscreen]
tint_intensity = 0.29999999329447746

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [ "lockscreen-login-box@eDP-1" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@eDP-1"]
    box_height = 70.0
    box_width = 400.0
    cx = 823.0
    cy = 910.0
    output = "eDP-1"
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@eDP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        input_opacity = 1.0
        input_radius = 6.0
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true

[notification]
background_opacity = 0.65999998524785042

[plugin_settings."noctalia/screen_recorder"]
audio_codec = "aac"
color_range = "full"
copy_to_clipboard = true
resolution = "1920x1080"
video_codec = "hevc"
video_source = "portal"

[plugin_settings."x0d7x/clipmask"]
mask_char = "$"

[plugins]
enabled = [ "noctalia/screen_recorder", "noctalia/example", "noctalia/kaomoji", "x0d7x/mangowm-status" ]

[shell]
avatar_path = "/home/dox/Downloads/7E1FA24E-E49E-469C-B7D1-02749AC79861.PNG"
clipboard_auto_paste = "off"
font_family = "JetBrainsMono NF"
niri_overview_type_to_launch_enabled = true
polkit_agent = true
screen_time_enabled = true
settings_show_advanced = true

    [shell.panel]
    control_center_placement = "floating"
    control_center_position = "center"
    session_placement = "floating"
    session_position = "center"
    transparency_mode = "glass"
    wallpaper_placement = "floating"
    wallpaper_position = "center"

[theme]
builtin = "Gruvbox"
community_palette = "Gruvbox Material"
mode = "dark"
source = "wallpaper"
wallpaper_scheme = "m3-tonal-spot"

    [theme.templates]
    builtin_ids = [ "btop", "gtk3", "gtk4", "ghostty", "kitty", "mango", "niri", "qt" ]
    community_ids = [ "pi-agent", "zen-browser", "discord", "yazi" ]

[wallpaper]
directory = "/home/dox/Documents/wallpaper"

    [wallpaper.default]
    path = "/home/dox/Documents/wallpaper/Wallpapers/0049.png"

    [wallpaper.last]
    path = "/home/dox/Documents/wallpaper/Wallpapers/0049.png"

    [wallpaper.monitors.eDP-1]
    path = "/home/dox/Documents/wallpaper/Wallpapers/0049.png"

[weather]
enabled = false

[widget.active_window]
max_length = 180

[widget.launcher]
glyph = "navigation-bolt"

[widget.media]
album_art_only = true
hide_when_no_media = true

[widget.network]
show_label = false

[widget.privacy]
hide_inactive = true

[widget.recorder]
type = "noctalia/screen_recorder:recorder"

[widget.spacer_2]
type = "spacer"

[widget.status]
type = "x0d7x/mangowm-status:status"

[widget.workspaces]
empty_color = "tertiary"
font_weight = 700
hide_when_empty = true
labels_only_when_occupied = true
scale = 1.05
